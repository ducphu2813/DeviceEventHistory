    <ItemGroup>
      <ProjectReference Include="..\DeviceEventStatistics.Application\DeviceEventStatistics.Application.csproj" />
      <ProjectReference Include="..\DeviceEventStatistics.Infrastructure\DeviceEventStatistics.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
        <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
